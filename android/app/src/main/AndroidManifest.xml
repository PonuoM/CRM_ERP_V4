<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- เด้งหน้าจอสายของเราได้แม้แอปถูกปัดทิ้ง/จอดับ — startActivity จาก service เฉย ๆ
         ถูกบล็อกตั้งแต่ Android 10 ทางที่ระบบอนุญาตคือ notification แบบ full-screen intent -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- ตามลบเบอร์ออกจากประวัติการโทรของเครื่อง — ระบบเขียนบันทึกทุกสายลง call log กลาง
         ซึ่งแอปโทรศัพท์/รายชื่อเดิมเปิดดูได้ ซ่อนบนหน้าจอสายอย่างเดียวจึงยังรั่ว -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrimacomDialer">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Required for the system to offer this app as a default dialer. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.CustomerDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.EndOfDayActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppointmentsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DispositionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true" />

        <activity
            android:name=".ui.SaleSummaryActivity"
            android:exported="false" />

        <!-- Our own in-call screen. Replaces the one that would print the number. -->
        <activity
            android:name=".ui.InCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.PrimacomDialer" />

        <!-- Once this app holds the dialer role the system routes calls here instead of the stock UI. -->
        <service
            android:name=".call.PrimacomInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- Deliberately NOT declaring IN_CALL_SERVICE_RINGING. Claiming it makes this app
                 responsible for playing the ringtone, and a silent incoming call is far worse than
                 the stock one. The screen is what we need to control, not the sound. -->
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Puts the bridge back after a reboot or an app update, with nobody present to tap it. -->
        <receiver
            android:name=".call.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Keeps polling while the screen is off. The handset sits on a desk on charge, so a
             foreground service is the honest way to stay reachable rather than fighting Doze. -->
        <service
            android:name=".call.CallBridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
                ชนิด dataSync ถูกจำกัดไว้ 6 ชั่วโมงต่อ 24 ชั่วโมงตั้งแต่ Android 15
                service ตัวนี้ต้องอยู่ตลอดวันทำงานเพื่อรอรับคำสั่งโทรจาก CRM ถ้าโดนตัด
                พนักงานจะกดโทรจากคอมแล้วเครื่องไม่ตอบสนอง โดยไม่มีอะไรแจ้งเตือน
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the agent handset connection to the company CRM so staff can place and receive customer calls from their workstation during working hours." />
        </service>

        <!-- แชร์รูปสรุปการขายออกไปแอปอื่น (ไลน์ ฯลฯ) ผ่าน content:// ที่ปลอดภัย -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
