# Optional overlay for this PC only. Prefer the project-root .env
# (C:\Project\CRM_ERP_V4\.env — see ../../.env.example).
#
# Copy this file to scripts/backup/.env only if you need different XAMPP paths
# or rclone on this machine. It overrides the root file. Do not deploy this folder.

MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe
MYSQL=C:\xampp\mysql\bin\mysql.exe
GZIP=C:\Program Files\Git\usr\bin\gzip.exe
WORKDIR=C:\Users\User\Documents\prima_db_backups
# Prefer setting RCLONE_DEST / KEEP_LOCAL in the project-root .env
RCLONE_DEST=
KEEP_LOCAL=1
