# Copy to .env in this folder (gitignored). Do not commit secrets.
# On the host put only the GOOGLE_DRIVE_* lines — never MYSQL_PASSWORD.

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REDIRECT_URI=https://prima49.com/mini_erp/api/backup_drive.php?action=oauth_callback

# Office dump helper (do not put these on the web host)
MYSQL_HOST=202.183.192.218
MYSQL_PORT=3306
MYSQL_USER=primacom_mini_erp_backup
MYSQL_PASSWORD=
MYSQL_DATABASE=primacom_mini_erp
MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe
MYSQL=C:\xampp\mysql\bin\mysql.exe
GZIP=C:\Program Files\Git\usr\bin\gzip.exe
WORKDIR=C:\Users\User\Documents\prima_db_backups
# After rclone config (remote name gdrive). Example: gdrive:Prima ERP DB backups
# Double-click scripts/backup/Open-BackupUi.cmd to open the dump UI.
RCLONE_DEST=
KEEP_LOCAL=1
# Full path if `rclone` is not on PATH (WinGet install on this PC)
RCLONE=
