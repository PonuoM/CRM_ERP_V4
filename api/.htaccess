RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
# If the request is not a real file, route to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ── กันสคริปต์ครั้งเดียวไม่ให้ถูกเรียกจากอินเทอร์เน็ต ────────────────────────────────────
#
# ไฟล์จริงในโฟลเดอร์นี้ถูก serve ตรง ไม่ผ่าน index.php (ดูเงื่อนไข !-f ข้างบน) การตรวจสิทธิ์
# ทั้งหมดอยู่ใน index.php สคริปต์ที่วางไว้ข้าง ๆ จึงข้ามด่านไปทั้งหมด
#
# เคยมีของจริงหลุดขึ้น production: migrate_reset_sheet_table.php ที่ DROP TABLE ข้อมูล 18,366 แถว
# และ kill_processes.php ที่ตัด connection ทุกคนจนระบบล่ม ทั้งคู่เปิด URL ครั้งเดียวก็ทำงาน
# ไม่ต้องล็อกอิน ลบไฟล์ออกไปแล้วแต่กฎนี้กันไม่ให้ของแบบเดียวกันกลับมาได้อีก
#
# บล็อกตามรูปแบบชื่อ ไม่ใช่บล็อกทั้งโฟลเดอร์ เพราะไฟล์อย่าง customers.php basket_config.php
# companies.php เป็นส่วนของระบบจริงที่หน้าเว็บเรียกอยู่ การบล็อกเหมารวมจะทำให้ระบบพัง
#
# เขียนรองรับทั้ง Apache 2.4 (Require) และ 2.2 (Order/Deny) โดยตั้งใจ
# host ตอบ header มาแค่ "Apache/2" ไม่บอกเวอร์ชันย่อย ถ้าใช้ไวยากรณ์ผิดรุ่น
# ทั้งโฟลเดอร์จะกลายเป็น HTTP 500 ทันที ซึ่งคือ API ตายทั้งระบบ
<FilesMatch "^(test_|dump_|show_|describe_|scan_|migrate_|kill_|convert_|manual_|fix_|init_|recreate_|clean_|optimize_|ensure_|create_.*table|add_.*column|database_sync|list_statuses).*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ไฟล์ log และ dump ฐานข้อมูลไม่ควรโหลดได้จากเว็บไม่ว่ากรณีใด
<FilesMatch "\.(log|sql|bak|old|orig|save)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── กุญแจและไฟล์ลับ ห้ามโหลดผ่านเว็บเด็ดขาด ─────────────────────────────────────────
#
# 2 ก.ย. 2569 ตรวจพบว่า https://prima49.com/mini_erp/api/google-credentials.json และ
# mdm-credentials.json ดาวน์โหลดได้จากอินเทอร์เน็ตแบบไม่ต้องล็อกอิน (HTTP 200 พร้อมเนื้อไฟล์เต็ม)
# ทั้งสองไฟล์อยู่ใน .gitignore จึงไม่มีใครเห็นตอนรีวิวโค้ด แต่มันอยู่บน host จริง
#
# ไม่ใช่ความเสี่ยงเชิงทฤษฎี: ในหน้า server-status วันเดียวกันมีบอตไล่ยิงหา
# /credentials.json และ /sa.json อยู่ ณ ขณะนั้น (sa = service account) ตรงกับชื่อไฟล์เหล่านี้พอดี
#
# กฎเดิมบล็อก .env ไว้แล้วแต่ไม่ครอบ .json จึงเติมตรงนี้ ครอบชื่อที่ใช้จริงในโปรเจกต์
# (google-credentials, mdm-credentials) และรูปแบบที่มักใช้กัน (secret, service-account, key)
# ไม่บล็อก .json ทั้งหมดโดยตั้งใจ เพราะ composer.json / manifest ฯลฯ ไม่ใช่ความลับ
# และการเหมารวมเคยทำระบบพังมาแล้ว
<FilesMatch "(credential|secret|service[-_]?account|private[-_]?key|serviceaccount)[^/]*\.(json|pem|p12|key)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
